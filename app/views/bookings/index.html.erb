<% content_for :title, "My bookings" %>

<div class="wrap page">
  <div class="page-head rise">
    <div>
      <h1>My bookings</h1>
      <p>Powers you've booked, and reviews waiting to be written.</p>
    </div>
    <%= link_to "Browse powers", superpowers_path, class: "button button--plain" %>
  </div>

  <% if @upcoming.empty? && @past.empty? %>
    <div class="empty rise">
      <h2>Nothing booked yet.</h2>
      <p>Find a power you like and pick some dates.</p>
      <%= link_to "Browse powers", superpowers_path, class: "button" %>
    </div>
  <% end %>

  <% if @upcoming.any? %>
    <h2 class="section-label">Coming up</h2>
    <div class="booking-list">
      <%= render partial: "bookings/booking", collection: @upcoming %>
    </div>
  <% end %>

  <% if @past.any? %>
    <h2 class="section-label">Past</h2>
    <div class="booking-list">
      <%= render partial: "bookings/booking", collection: @past %>
    </div>
  <% end %>
</div>
