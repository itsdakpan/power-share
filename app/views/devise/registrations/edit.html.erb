<% content_for :title, "Account" %>

<div class="wrap form-shell">
  <div class="form-card rise">
    <h1>Your account</h1>
    <p class="form-card__lead">Update your details. You'll need your current password to save.</p>
    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= f.error_notification message: "Please fix the fields below." %>
      <%= f.input :first_name, label: "First name", input_html: { autocomplete: "given-name" } %>
      <%= f.input :email, required: true, input_html: { autocomplete: "email" } %>
      <%= f.input :password, label: "New password", hint: "Leave blank to keep your current one", required: false, input_html: { autocomplete: "new-password" } %>
      <%= f.input :password_confirmation, label: "Confirm new password", required: false, input_html: { autocomplete: "new-password" } %>
      <%= f.input :current_password, required: true, input_html: { autocomplete: "current-password" } %>
      <div class="form-actions">
        <%= f.button :submit, "Save changes", class: "button" %>
        <%= link_to "Cancel", superpowers_path, class: "button button--plain" %>
      </div>
    <% end %>
  </div>

  <div class="form-card mt-4">
    <h2 class="h4">Delete account</h2>
    <p class="muted">This removes your listings, bookings and reviews. It can't be undone.</p>
    <%= button_to "Delete my account", registration_path(resource_name), method: :delete,
                  form: { data: { turbo_confirm: "Delete your account and all your data?" } },
                  class: "button button--danger" %>
  </div>
</div>
