<div class="auth__links">
  <%- if controller_name != 'sessions' %>
    <span>Already have an account? <%= link_to "Log in", new_session_path(resource_name) %></span>
  <% end %>
  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <span>New here? <%= link_to "Create an account", new_registration_path(resource_name) %></span>
  <% end %>
  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' && !Rails.env.production? %>
    <span><%= link_to "Forgot your password?", new_password_path(resource_name) %></span>
  <% end %>
</div>
