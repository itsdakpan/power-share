<% content_for :bare, true %>
<% content_for :title, "Log in" %>

<div class="auth">
  <%= render "devise/shared/auth_art", image: "flight.jpg", line: "Your next booking is one login away." %>
  <div class="auth__panel">
    <div class="auth__form rise">
      <%= link_to root_path, class: "back-link" do %>
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Home
      <% end %>
      <h1>Log in</h1>
      <p class="auth__lead">Welcome back.</p>
      <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <%= f.input :email, required: false, autofocus: true, input_html: { autocomplete: "email" } %>
        <%= f.input :password, required: false, input_html: { autocomplete: "current-password" } %>
        <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
        <%= f.button :submit, "Log in", class: "button button--block mt-2" %>
      <% end %>
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
