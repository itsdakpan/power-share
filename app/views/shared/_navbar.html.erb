<header class="topbar">
  <div class="wrap topbar__inner">
    <%= link_to root_path, class: "topbar__brand" do %>
      <%= image_tag "bolt.png", alt: "", width: 30, height: 30 %>
      <span>Power-Share</span>
    <% end %>

    <nav class="topbar__links" aria-label="Main">
      <%= nav_link "Browse", superpowers_path, icon: "fa-magnifying-glass" %>
      <% if user_signed_in? %>
        <%= nav_link "My bookings", bookings_path, icon: "fa-calendar-check" %>
        <%= link_to new_superpower_path, class: "button button--small" do %>
          <i class="fa-solid fa-plus" aria-hidden="true"></i><span>List a power</span>
        <% end %>
        <details class="topbar__user ms-1">
          <summary aria-label="Account menu"><%= avatar_for current_user %></summary>
          <div class="topbar__menu">
            <div class="topbar__menu-name"><%= current_user.display_name %></div>
            <%= link_to edit_user_registration_path do %>
              <i class="fa-regular fa-user" aria-hidden="true"></i> Account
            <% end %>
            <%= button_to destroy_user_session_path, method: :delete do %>
              <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i> Log out
            <% end %>
          </div>
        </details>
      <% else %>
        <%= link_to "Log in", new_user_session_path %>
        <%= link_to "Sign up", new_user_registration_path, class: "button button--small ms-1" %>
      <% end %>
    </nav>
  </div>
</header>
