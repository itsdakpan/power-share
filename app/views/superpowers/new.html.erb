<% content_for :title, "List a power" %>

<div class="wrap form-shell">
  <%= link_to superpowers_path, class: "back-link" do %>
    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> All powers
  <% end %>
  <div class="form-card rise">
    <h1>List a power</h1>
    <p class="form-card__lead">Tell people what it does and what it costs per day.</p>
    <%= render "form", submit_label: "Publish listing" %>
  </div>
</div>
