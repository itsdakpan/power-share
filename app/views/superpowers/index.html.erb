<% content_for :title, "Browse powers" %>

<div class="wrap page">
  <div class="page-head rise">
    <div>
      <h1>Browse powers</h1>
      <p><%= pluralize(@superpowers.size, "power") %> available<%= " for \"#{@query}\"" if @query.present? %>.</p>
    </div>
    <%= link_to new_superpower_path, class: "button" do %>
      <i class="fa-solid fa-plus" aria-hidden="true"></i> List a power
    <% end %>
  </div>

  <%= form_with url: superpowers_path, method: :get, class: "search rise", role: "search", data: { turbo_frame: "_top" } do %>
    <%= label_tag :q, "Search powers", class: "visually-hidden" %>
    <%= search_field_tag :q, @query, class: "form-control", placeholder: "Try flight or strength" %>
    <button type="submit" class="button button--plain" aria-label="Search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
  <% end %>

  <% if @superpowers.any? %>
    <div class="power-grid">
      <% @superpowers.each_with_index do |superpower, i| %>
        <%= render "superpowers/card", superpower: superpower, index: [i, 8].min %>
      <% end %>
    </div>
  <% else %>
    <div class="empty rise">
      <h2>No powers match that.</h2>
      <p>Try another word, or list the power you were looking for.</p>
      <%= link_to "Clear search", superpowers_path, class: "button button--plain" %>
    </div>
  <% end %>
</div>
