<section class="hero">
  <div class="wrap hero__grid">
    <div>
      <h1 class="rise">Rent a <mark>superpower</mark> for the weekend.</h1>
      <p class="hero__lead rise" style="--i: 1">Flight for a birthday. Super strength for moving day. Book real powers from the people who have them.</p>
      <div class="hero__actions rise" style="--i: 2">
        <%= link_to superpowers_path, class: "button" do %>
          Browse powers <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        <% end %>
        <%= link_to "List your power", (user_signed_in? ? new_superpower_path : new_user_registration_path), class: "button button--plain" %>
      </div>
    </div>
    <div class="hero__art rise" style="--i: 1">
      <%= image_tag "hero-comic.jpg", alt: "Comic-style heroes flying and firing laser vision over a city", width: 1400, height: 704, fetchpriority: "high" %>
    </div>
  </div>
</section>

<% if @superpowers.any? %>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Top rated right now.</h2>
        <%= link_to "See all powers", superpowers_path, class: "button button--plain button--small" %>
      </div>
      <div class="power-grid">
        <%= render partial: "superpowers/card", collection: @superpowers, as: :superpower, locals: { index: 0 } %>
      </div>
    </div>
  </section>
<% end %>

<section class="section pt-0">
  <div class="wrap">
    <div class="section-head"><h2>How it works.</h2></div>
    <div class="how">
      <div class="how__cell how__photo how__photo--flight">
        <%= image_tag "flight.jpg", alt: "Two people flying over a sunny city skyline", loading: "lazy", width: 1400, height: 764 %>
        <div class="how__text">
          <h3>Pick a power</h3>
          <p>Browse flight, strength, invisibility and more. Every listing shows the price per day and what past renters thought.</p>
        </div>
      </div>
      <div class="how__cell how__photo">
        <%= image_tag "strength.jpg", alt: "A man lifting a huge metal slab above his head in the street", loading: "lazy", width: 1400, height: 764 %>
        <div class="how__text">
          <h3>Book your dates</h3>
          <p>Choose a start and end date and see the total before you confirm.</p>
        </div>
      </div>
      <div class="how__cell how__cell--bolt">
        <div class="how__text">
          <h3>Save the day, then review it</h3>
          <p>Once you've used a power, leave a star rating so the next person knows what they're getting.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="closing">
  <div class="wrap">
    <div class="closing__panel">
      <%= image_tag "comic-title.jpg", alt: "Comic panel with the words Super Powers above a running hero", loading: "lazy", width: 1400, height: 764 %>
      <div class="closing__copy">
        <h2>Got a power going spare?</h2>
        <p>List it in a couple of minutes. Set your own daily price and let the bookings come to you.</p>
        <%= link_to "List your power", (user_signed_in? ? new_superpower_path : new_user_registration_path), class: "button" %>
      </div>
    </div>
  </div>
</section>
